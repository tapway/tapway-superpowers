{
  "description": "Tapway Superpowers hooks \u2014 enforceable quality gates",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tool-guard/tool-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash-safety/pre-bash-safety.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-secrets/pre-commit-secrets.sh\"",
            "if": "Bash(git commit:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-gate/pre-commit-gate.sh\"",
            "if": "Bash(git commit:*)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/dependency-audit/dependency-audit.sh\"",
            "if": "Bash(git commit:*)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-pr-contract/pre-pr-contract.sh\"",
            "if": "Bash(gh pr create:*)",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|NotebookEdit|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tool-guard/tool-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-brainstorm-ground/pre-brainstorm-ground.sh\"",
            "timeout": 10,
            "statusMessage": "Checking brainstorm grounding"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-plan-issue/post-plan-issue.sh\"",
            "timeout": 60,
            "statusMessage": "Creating the GitHub issue for this plan"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-write-lint/post-write-lint.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-commit-release-note/post-commit-release-note.sh\"",
            "if": "Bash(git commit:*)",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start/session-start.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-execute-github-issue/check.sh\"",
            "timeout": 30,
            "description": "Detect an existing GitHub issue for this branch (detect-only; the issue is created automatically after the plan is written, by hooks/post-plan-issue)"
          }
        ]
      }
    ]
  }
}
